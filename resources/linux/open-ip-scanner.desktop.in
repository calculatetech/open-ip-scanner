[Desktop Entry]
Type=Application
Version=1.0
Name=Open IP Scanner
GenericName=Network Scanner
Comment=Scan local networks for active hosts and services
Exec=open-ip-scanner
TryExec=open-ip-scanner
Icon=@OIS_APP_ID@
Terminal=false
NoDisplay=false
Categories=Network;
Keywords=ip;network;scanner;lan;host;service;
StartupNotify=true
StartupWMClass=open-ip-scanner
X-KDE-Wayland-Desktop-File=@OIS_APP_ID@.desktop
